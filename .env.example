# --- Service ---
PORT=4001
NODE_ENV=development
# Origines autorisées (séparées par des virgules) : front Vite en direct, sans Gateway
CORS_ORIGINS=http://localhost:5173
# URL publique du front (liens des e-mails)
FRONTEND_URL=http://localhost:5173

# --- Base de données ---
MONGODB_URI=mongodb://localhost:27017/smartcampus_users

# --- JWT (le même secret doit être connu des autres services pour vérifier le jeton) ---
JWT_SECRET=change-me-en-production-32-caracteres-minimum
JWT_EXPIRES_IN=2h

# --- Règles métier ---
# Doit être identique à VITE_EMAIL_DOMAIN côté front
EMAIL_DOMAIN=smartcampus.tn
MAX_LOGIN_ATTEMPTS=5

# --- Premier administrateur (créé au démarrage s'il n'existe aucun admin) ---
FIRST_ADMIN_EMAIL=admin@smartcampus.tn
FIRST_ADMIN_PASSWORD=Admin2026!
FIRST_ADMIN_FIRST_NAME=Admin
FIRST_ADMIN_LAST_NAME=SmartCampus

# --- E-mail (Mailpit en développement : SMTP 1025, interface http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SmartCampus <no-reply@smartcampus.tn>"
# Dev uniquement : renvoie le mot de passe temporaire dans la réponse de POST /users
EXPOSE_TEMP_PASSWORD=false

# --- Bus d'événements (optionnel). Vide = événements journalisés seulement ---
RABBITMQ_URL=
RABBITMQ_EXCHANGE=smartcampus.events
