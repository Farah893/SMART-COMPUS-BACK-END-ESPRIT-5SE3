# --- Service ---
PORT=4001
NODE_ENV=development
# Niveau des logs : fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Origines autorisées (séparées par des virgules) : front Vite en direct, sans Gateway
CORS_ORIGINS=http://localhost:5173
# URL publique du front, utilisée par les boutons des e-mails. En production : https://campus.votre-domaine.tn
FRONTEND_URL=http://localhost:5173

# --- Base de données ---
MONGODB_URI=mongodb://localhost:27017/smartcampus_users

# --- JWT (le même secret doit être connu des autres services pour vérifier le jeton) ---
# Signature des jetons. PRODUCTION : RS256 obligatoire (npm run keys:generate, puis JWT_PRIVATE_KEY_FILE).
# DÉVELOPPEMENT : sans clé, le service signe en HS256 avec JWT_SECRET ci-dessous.
# JWT_PRIVATE_KEY_FILE=keys/jwt-private.pem
# JWT_PRIVATE_KEY=            (PEM encodé en base64, pour les plateformes sans fichier)
# JWT_PREVIOUS_PUBLIC_KEY=    (ancienne clé publique, le temps d'une rotation)
# JWT_ISSUER=smartcampus-user-service
# JWT_AUDIENCE=smartcampus
JWT_SECRET=change-me-en-production-32-caracteres-minimum
JWT_EXPIRES_IN=2h

# --- Règles métier ---
# Doit être identique à VITE_EMAIL_DOMAIN côté front
EMAIL_DOMAIN=gmail.com
MAX_LOGIN_ATTEMPTS=5

# --- Premier administrateur (créé au démarrage s'il n'existe aucun admin) ---
FIRST_ADMIN_EMAIL=admin@gmail.com
FIRST_ADMIN_PASSWORD=Admin2026!
FIRST_ADMIN_FIRST_NAME=Admin
FIRST_ADMIN_LAST_NAME=SmartCampus

# --- E-mail (Mailpit en développement : SMTP 1025, interface http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SmartCampus <no-reply@smartcampus.tn>"
# Dev uniquement : renvoie le mot de passe temporaire dans la réponse de POST /users
EXPOSE_TEMP_PASSWORD=false

# --- Bus d'événements (optionnel). Vide = événements journalisés seulement ---
RABBITMQ_URL=
RABBITMQ_EXCHANGE=smartcampus.events

# --- Durcissement (voir docs/SECURITE.md) ---
# Nombre de proxys de confiance devant le service (0 = X-Forwarded-For ignoré ; 1 derrière la Gateway)
# TRUST_PROXY=0
# Documentation /docs : active hors production seulement (ENABLE_DOCS=true pour la forcer)
# ENABLE_DOCS=false
# BCRYPT_ROUNDS=12
# Verrouillage temporaire après MAX_LOGIN_ATTEMPTS échecs, levé tout seul après LOCKOUT_MINUTES
# LOCKOUT_MINUTES=15
# CODE_MAX_ATTEMPTS=5
# EMAIL_COOLDOWN_SECONDS=60

# --- Sessions longues (jetons de rafraîchissement) ---
REFRESH_TOKEN_TTL_DAYS=30

# --- Cookies de session (mode « X-Auth-Mode: cookie » utilisé par le front) ---
# SameSite : strict (défaut) si le front et l'API sont sur le même site (ex. app.exemple.tn et api.exemple.tn).
# « none » seulement si les domaines diffèrent : exige COOKIE_SECURE=true, et la protection CSRF devient essentielle.
# COOKIE_SAMESITE=strict
# COOKIE_DOMAIN=
# COOKIE_SECURE=true   (par défaut : true en production, false sinon)

# --- Boîte d'envoi des événements (active seulement si RABBITMQ_URL est défini) ---
# OUTBOX_POLL_MS=1000
# OUTBOX_BATCH_SIZE=50
# OUTBOX_LEASE_MS=30000
# OUTBOX_MAX_BACKOFF_MS=60000
# OUTBOX_RETENTION_DAYS=7

# --- Observabilité ---
# /metrics (Prometheus) : exige ce jeton ; sans jeton la route n'existe qu'en développement
# METRICS_TOKEN=un-jeton-d-au-moins-8-caracteres
# Traces OpenTelemetry (inactives sans l'une de ces deux lignes)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACES_EXPORTER=console

# --- Exploitation ---
# Délai entre « /ready = 503 » et la fermeture à l'arrêt (défaut : 5000 en production, 0 sinon)
# SHUTDOWN_DRAIN_MS=5000
# MONGO_MAX_POOL_SIZE=20
# MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
